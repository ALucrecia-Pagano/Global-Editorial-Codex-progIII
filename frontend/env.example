# Formato: host:puerto (sin http:// ni barra final)

# Entorno local (Docker Desktop conectando al backend local en puerto 8000):
API_UPSTREAM=host.docker.internal:8000

# Easypanel (red interna entre servicios App del mismo proyecto):
# API_UPSTREAM=<proyecto>_<servicio-api>:8000  (en este despliegue: calculadora_libreria-api:8000)
